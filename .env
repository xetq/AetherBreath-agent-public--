
# API 密钥（到厂商控制台创建，形如 sk-xxxx）
LLM_API_KEY=

# API 端点（OpenAI 兼容的 /chat/completions 基地址，注意带 /v1，以厂商文档为准）
LLM_BASE_URL=

# 模型参数
LLM_MODEL=
LLM_REASONING_EFFORT=high
LLM_THINKING_ENABLED=true
MAX_ITERATIONS=120

# ===== 日志系统 =====
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_SAMPLING_RATE=0.1             # DEBUG 日志采样率（0.0 ~ 1.0），1.0=全量，0.0=关闭 DEBUG
LOG_QUEUE_SIZE=1000               # 异步队列大小
LOG_BACKPRESSURE_THRESHOLD=500    # 队列积压超过此值触发背压（自动降级到 WARNING）
LOG_JSON_INDENT=None              # 生产环境留空（紧凑），调试时可设 2（美化）
LOG_SECRETS_REDACT=True           # 是否启用脱敏

# ========== 其他 ==========
