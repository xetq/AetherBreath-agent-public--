# ============================================================
# AetherBreath Agent — LLM 配置模板（支持任意 OpenAI 兼容厂商）
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：
#       项目根:  cp .env.example .env
#       agent/ :  cp .env.example agent/.env     （两处都认，项目根优先）
#   2. 填入你的密钥与端点
#   3. 启动 agent 时会打印当前生效的 LLM 配置摘要，可用来核对
#
# ⚠️ .env 含密钥，已加入 .gitignore，请勿提交到 git。
# ⚠️ 切换厂商只需改下面三个核心变量；改完重启 agent 生效。
# ⚠️ 如果你曾在 agent/.env 里配过旧键（DEEPSEEK_*/MODEL_NAME），
#    且现在改用 LLM_* 新键，建议把旧键一并清理，避免混淆。
# ============================================================

# ---------- 核心三件套（必填） ----------

# API 密钥（到厂商控制台创建，形如 sk-xxxx）
LLM_API_KEY=sk-在这里填你的密钥

# API 端点（OpenAI 兼容的 /chat/completions 基地址，注意带 /v1，以厂商文档为准）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（填厂商实际提供的模型名）
LLM_MODEL=deepseek-chat

# ---------- 各厂商示例（任选一家，把上面三行换成对应值） ----------
#
# ✅ DeepSeek（deepseek.com）
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat            # 普通对话模型
#   LLM_MODEL=deepseek-reasoner        # 深度思考模型
#   LLM_THINKING_ENABLED=true          # DeepSeek 官方对 reasoning 模型要求 thinking 字段
#
# ✅ 智谱 AI（open.bigmodel.cn，GLM 系列，有免费额度）
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4.7-flash
#
# ✅ 硅基流动（siliconflow.cn，聚合多家开源模型，有免费额度）
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=deepseek-ai/DeepSeek-V3
#   LLM_MODEL=Qwen/Qwen3-8B
#
# ✅ Moonshot Kimi（platform.moonshot.cn）
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
#
# ✅ OpenAI
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_REASONING_EFFORT=low           # OpenAI 系支持 low/medium/high
#
# ✅ 本地 Ollama（先 ollama serve 再填）
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:8b
#
# ✅ 阿里云百炼（DashScope，OpenAI 兼容模式）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
# ✅ 腾讯云混元 / 百度千帆 / 字节火山方舟 / OpenRouter……只要是 OpenAI 兼容端点都能用

# ---------- 可选：厂商专属行为参数（默认关闭 = 最兼容） ----------
# 注意：多数厂商不认这两个参数，开了可能报 400；仅在目标模型明确支持时开启。

# 推理强度（reasoning_effort）：off=完全不发送该字段（兼容性最好）
# 可选：off / low / medium / high
LLM_REASONING_EFFORT=off

# 思考模式：true=请求体附加 {"thinking":{"type":"enabled"}}
# 仅 DeepSeek 系（deepseek-reasoner）、智谱 GLM 等支持 thinking 的模型可开
LLM_THINKING_ENABLED=false

# ---------- 其它可选配置 ----------
# Agent 单轮最多工具调用迭代数
#MAX_ITERATIONS=100

# 日志级别：DEBUG / INFO / WARNING / ERROR
#LOG_LEVEL=INFO

# 模型缓存目录（离线模型等）
#HF_HOME=

# ---------- 旧键名兼容（可选，二选一即可） ----------
# 新配置请用上面的 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL；
# 下面的旧键仅在你沿用历史配置、没有使用 LLM_* 时才会被读取。
#DEEPSEEK_API_KEY=sk-...
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#MODEL_NAME=deepseek-chat
